' One window, two pages.
'
' Sub Main makes the window and shows the first page in it. Changing page means
' showing the other one in the same window — which is what ShowIn does, and why
' neither page needs to know about the other beyond its name.
Imports javax.swing

Module Main
    Sub Main()
        Dim window As JFrame = New JFrame("Two pages")
        window.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE)
        New PageOne(window).ShowIn(window)
    End Sub
End Module
