' The third screen: a form that goes into a dialog and leaves an answer behind.
'
' No ShowIn here, because this one is never a window of its own. It is a panel somebody puts into a
' JDialog — which is possible precisely because a form is a panel and not a window.

Imports javax.swing
Imports java.awt

Public Class CustomerPicker

    ' Read by the caller after the dialog closes. -1 means cancelled, and saying so explicitly is
    ' better than leaving the caller to wonder whether anything happened.
    Public Gewaehlt As Integer = -1

    Private wurzel As JPanel = New JPanel()
    Private liste As JList = New JList()

    Private Sub OnOk()
        Gewaehlt = liste.getSelectedIndex()
        schliesse()
    End Sub

    Private Sub OnAbbruch()
        Gewaehlt = -1
        schliesse()
    End Sub

    Private Sub schliesse()
        Dim fenster As java.awt.Window = SwingUtilities.getWindowAncestor(wurzel)
        If fenster IsNot Nothing Then
            fenster.dispose()
        End If
    End Sub

    Public Function GetRootPane() As JPanel
        wurzel.setLayout(New BorderLayout(8, 8))
        wurzel.setBorder(BorderFactory.createEmptyBorder(12, 12, 12, 12))

        liste.setListData(CustomerList.Namen)
        liste.setSelectedIndex(0)
        wurzel.add(New JScrollPane(liste), BorderLayout.CENTER)

        Dim knoepfe As JPanel = New JPanel(New GridLayout(1, 2, 6, 0))
        Dim btnOk As JButton = New JButton("Take this one")
        Dim btnAbbruch As JButton = New JButton("Cancel")
        btnOk.addActionListener(Sub(e) OnOk())
        btnAbbruch.addActionListener(Sub(e) OnAbbruch())
        knoepfe.add(btnOk)
        knoepfe.add(btnAbbruch)
        wurzel.add(knoepfe, BorderLayout.SOUTH)

        Return wurzel
    End Function

End Class
