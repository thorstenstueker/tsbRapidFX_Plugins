' The article list. Apart from the columns, the same as the customer list - and deliberately so:
' whoever has read one of the two knows the other.
Imports java.awt
Imports java.awt.event
Imports java.util
Imports javax.swing

Public Class ArticleListForm

    Private shell As MainWindow

    ' The articles currently in the table - row for row, the same order.
    Private hits As ArrayList = New ArrayList()

    Public Sub New(owner As MainWindow)
        InitDesignerComponents()
        shell = owner
        Fill()
    End Sub

    Public Sub Refresh()
        Dim row As Integer = tblArticles.Table().getSelectedRow()
        Fill()
        SelectRow(row)
    End Sub

    Private Sub Fill()
        hits = ArticleFile.Search(txtSearch.Text)

        tblArticles.Clear()
        Dim entry As Object
        For Each entry In hits
            Dim a As Article = CType(entry, Article)
            tblArticles.AddRow(a.Number, a.Name, a.Unit, _
                               Util.Money(a.Price), Util.QuantityText(a.Vat) + " %", _
                               Util.QuantityText(a.Stock))
        Next entry
        tblArticles.Reload()

        lblCount.Text = hits.size() + " articles found"
        lblHint.Text = ""
    End Sub

    Private Sub SelectRow(row As Integer)
        If row >= 0 AndAlso row < hits.size() Then
            tblArticles.Table().setRowSelectionInterval(row, row)
        End If
    End Sub

    Private Function Chosen() As Article
        Dim row As Integer = tblArticles.Table().getSelectedRow()
        If row < 0 OrElse row >= hits.size() Then
            lblHint.Text = "Please select a row first."
            Return Nothing
        End If
        lblHint.Text = ""
        Return CType(hits.get(row), Article)
    End Function

    ' --- the buttons ---------------------------------------------------------------------

    Private Sub OnSearch(e As ActionEvent)
        Fill()
    End Sub

    Private Sub OnAll(e As ActionEvent)
        txtSearch.Text = ""
        Fill()
    End Sub

    Private Sub OnNew(e As ActionEvent)
        shell.ShowArticleSheet(0)
    End Sub

    Private Sub OnEdit(e As ActionEvent)
        Dim a As Article = Chosen()
        If a Is Nothing Then
            Exit Sub
        End If
        shell.ShowArticleSheet(a.Id)
    End Sub

    Private Sub OnDelete(e As ActionEvent)
        Dim a As Article = Chosen()
        If a Is Nothing Then
            Exit Sub
        End If
        Dim answer As Integer = JOptionPane.showConfirmDialog(shell.Owner(), _
                "Really delete article " + a.Number + " - " + a.Name + "?", _
                "Delete", JOptionPane.YES_NO_OPTION)
        If answer <> JOptionPane.YES_OPTION Then
            Exit Sub
        End If

        Dim problem As String = ArticleFile.Delete(a.Id)
        If problem <> "" Then
            lblHint.Text = problem
            Exit Sub
        End If
        Fill()
        lblHint.Text = "Article " + a.Number + " deleted."
    End Sub




