' The sign-in screen - the first thing the program's window shows.
'
' It is not a separate window and not a dialog. There is one JFrame for the whole program, made
' in Sub Main, and this form is simply what is inside it to begin with. When somebody signs in,
' MainWindow takes the same frame over. That is why the frame is handed to the constructor.
'
' This half, above the banner, is yours. The designer writes it back unchanged and only ever
' adds to it - a missing import, an empty handler body.
Imports java.awt
Imports java.awt.event
Imports javax.swing

Public Class SignInForm

    Private frame As JFrame

    Public Sub New(f As JFrame)
        InitDesignerComponents()
        frame = f
    End Sub

    ' ShowIn is the designer's own method: it sets the title, puts this form into the frame,
    ' sizes it, centres it and makes it visible. On a web form the designer generates no such
    ' thing - there is no window there to show anything in.
    Public Sub Open()
        ShowIn(frame)
        txtUser.requestFocusInWindow()
    End Sub

    ' One message for both kinds of failure, deliberately: "no such user" and "wrong password"
    ' are the same sentence, because telling them apart tells a stranger something.
    Private Sub OnSignIn(e As ActionEvent)
        Dim typed As String = java.lang.String.valueOf(txtPassword.getPassword())
        Dim who As User = UserFile.SignIn(txtUser.Text, typed)
        If who Is Nothing Then
            lblHint.Text = "Sign-in failed. Please try again."
            txtPassword.setText("")
            txtPassword.requestFocusInWindow()
            Exit Sub
        End If

        ' The same frame, a different form inside it.
        New MainWindow(frame, who).Open()
    End Sub




