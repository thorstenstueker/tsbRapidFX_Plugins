    ' @tsbswx form class=SignInForm root=AnchorPanel ziel=DESKTOP platform=CUSTOM w=540 h=380 showIn=true theme=FlatLightLaf
    Private rootPane As JPanel = New JPanel()
    Private rootPaneLayout As SpringLayout = New SpringLayout()

    ' @tsbswx Label lblTitle parent=rootPane L=48 T=44 W=444 H=34
    Private lblTitle As JLabel = New JLabel()

    ' @tsbswx Label lblSubtitle parent=rootPane L=48 T=82 W=444 H=22
    Private lblSubtitle As JLabel = New JLabel()

    ' @tsbswx Label lblUser parent=rootPane L=48 T=152 W=100 H=24
    Private lblUser As JLabel = New JLabel()

    ' @tsbswx TextField txtUser parent=rootPane L=158 T=150 W=334 H=28
    Private txtUser As JTextField = New JTextField()

    ' @tsbswx Label lblPassword parent=rootPane L=48 T=192 W=100 H=24
    Private lblPassword As JLabel = New JLabel()

    ' @tsbswx PasswordField txtPassword parent=rootPane L=158 T=190 W=334 H=28
    Private txtPassword As JPasswordField = New JPasswordField()

    ' @tsbswx Button btnSignIn parent=rootPane L=158 T=240 W=160 H=32
    Private btnSignIn As JButton = New JButton()

    ' @tsbswx Label lblHint parent=rootPane L=48 T=296 W=444 H=24
    Private lblHint As JLabel = New JLabel()

    ' Builds this form's interface.
    '
    ' Call it from the constructor. It works only on instance fields, so every
    ' instance of this form has components of its own.
    Private Sub InitDesignerComponents()
        rootPane.setName("rootPane")
        rootPane.setLayout(rootPaneLayout)
        rootPane.setPreferredSize(New Dimension(540, 380))

        lblTitle.setName("lblTitle")
        lblTitle.setFont(New Font("SansSerif", Font.BOLD, 24))
        lblTitle.setText("RapidX ERP")
        lblTitle.setPreferredSize(New Dimension(444, 34))
        rootPaneLayout.putConstraint(SpringLayout.WEST, lblTitle, 48, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, lblTitle, 44, SpringLayout.NORTH, rootPane)
        rootPane.add(lblTitle)

        lblSubtitle.setName("lblSubtitle")
        lblSubtitle.setText("Business software — please sign in")
        lblSubtitle.setPreferredSize(New Dimension(444, 22))
        rootPaneLayout.putConstraint(SpringLayout.WEST, lblSubtitle, 48, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, lblSubtitle, 82, SpringLayout.NORTH, rootPane)
        rootPane.add(lblSubtitle)

        lblUser.setName("lblUser")
        lblUser.setText("User")
        lblUser.setPreferredSize(New Dimension(100, 24))
        rootPaneLayout.putConstraint(SpringLayout.WEST, lblUser, 48, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, lblUser, 152, SpringLayout.NORTH, rootPane)
        rootPane.add(lblUser)

        txtUser.setName("txtUser")
        txtUser.addActionListener(AddressOf OnSignIn)
        txtUser.setPreferredSize(New Dimension(334, 28))
        rootPaneLayout.putConstraint(SpringLayout.WEST, txtUser, 158, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, txtUser, 150, SpringLayout.NORTH, rootPane)
        rootPane.add(txtUser)

        lblPassword.setName("lblPassword")
        lblPassword.setText("Password")
        lblPassword.setPreferredSize(New Dimension(100, 24))
        rootPaneLayout.putConstraint(SpringLayout.WEST, lblPassword, 48, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, lblPassword, 192, SpringLayout.NORTH, rootPane)
        rootPane.add(lblPassword)

        txtPassword.setName("txtPassword")
        txtPassword.addActionListener(AddressOf OnSignIn)
        txtPassword.setPreferredSize(New Dimension(334, 28))
        rootPaneLayout.putConstraint(SpringLayout.WEST, txtPassword, 158, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, txtPassword, 190, SpringLayout.NORTH, rootPane)
        rootPane.add(txtPassword)

        btnSignIn.setName("btnSignIn")
        btnSignIn.setText("Sign in")
        btnSignIn.addActionListener(AddressOf OnSignIn)
        btnSignIn.setPreferredSize(New Dimension(160, 32))
        rootPaneLayout.putConstraint(SpringLayout.WEST, btnSignIn, 158, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, btnSignIn, 240, SpringLayout.NORTH, rootPane)
        rootPane.add(btnSignIn)

        lblHint.setName("lblHint")
        lblHint.setText("User admin, password secret")
        lblHint.setPreferredSize(New Dimension(444, 24))
        rootPaneLayout.putConstraint(SpringLayout.WEST, lblHint, 48, SpringLayout.WEST, rootPane)
        rootPaneLayout.putConstraint(SpringLayout.NORTH, lblHint, 296, SpringLayout.NORTH, rootPane)
        rootPane.add(lblHint)
    End Sub

    ' The root panel of this form.
    Public Function GetRootPane() As JPanel
        Return rootPane
    End Function

    ' Shows this form in the given frame. No statics: this instance, this window.
    Public Sub ShowIn(frame As JFrame)
        frame.setTitle("RapidX ERP")
        frame.setContentPane(rootPane)
        frame.setSize(540, 380)
        frame.setLocationRelativeTo(Nothing)
        frame.setVisible(True)
    End Sub
End Class
