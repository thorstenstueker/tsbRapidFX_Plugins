' The document sheet: head, lines, totals - and the same screen for a quotation, a delivery note
' and an invoice.
'
' Compare this with the web version and the difference is one word. There, the document being
' edited had to live in the session, because adding a line rebuilt the whole display and a field
' of the form would have been thrown away with it. Here the form stays on the screen while it is
' being worked on, so the document is an ordinary field - and the sentence in the web version
' explaining why it could not be one is simply gone.
Imports java.awt
Imports java.awt.event
Imports java.util
Imports javax.swing

Public Class DocumentSheetForm

    Private shell As MainWindow

    ' The document being edited. An ordinary field: this form lives as long as the editing does.
    Private doc As Document

    ' The customers and articles behind the two combo boxes, in the same order.
    Private customers As ArrayList = New ArrayList()
    Private articles As ArrayList = New ArrayList()

    ' While the screen is being built, an event is not a user's doing.
    '
    ' Without this the customer was lost on carrying a document over, and the way there is worth
    ' knowing: the first addItem selects by itself in a JComboBox, so OnCustomerChosen ran while
    ' the box was still being filled - with the placeholder as the selection. CollectHead
    ' thereupon wrote customer number 0 into the document, and what was marked afterwards was,
    ' quite consistently, the placeholder again. A quotation for Bauzentrum Sued KG became an
    ' invoice with no recipient, and the message read "The document cannot be saved without ...".
    Private building As Boolean = True

    Public Sub New(owner As MainWindow, document As Document)
        InitDesignerComponents()
        shell = owner
        doc = document

        FillCombos()
        Display()
        ShowLines()

        ' From here on, every event comes from a human being.
        building = False
    End Sub

    ' --- building it ------------------------------------------------------------------

    ' The two combo boxes hold customers and articles themselves, not their numbers. What comes
    ' back out of one is therefore a customer, and does not have to be found again from its text.
    Private Sub FillCombos()
        ' A placeholder with the number 0 at the very top. Without it the first customer of the
        ' file would stand there preselected, and a quotation would go to them by accident: a
        ' JComboBox selects by itself on the first addItem, and an empty line instead does not
        ' read as a request to choose.
        Dim none As Customer = New Customer()
        none.Number = ""
        none.Name = "— please choose a customer —"

        customers = New ArrayList()
        customers.add(none)
        customers.addAll(CustomerFile.All())

        Dim entry As Object
        For Each entry In customers
            cmbCustomer.addItem(entry)
        Next entry

        articles = ArticleFile.All()
        For Each entry In articles
            cmbArticle.addItem(entry)
        Next entry
    End Sub

    Private Sub Display()
        lblTitle.Text = doc.Kind + " " + doc.Number
        If doc.Id = 0 Then
            lblTitle.Text = lblTitle.Text + "  (new)"
        End If

        ' An invoice becomes nothing further.
        btnConvert.setVisible((doc.Kind <> Document.INVOICE))

        txtNumber.Text = doc.Number
        txtDate.Text = Util.DateShown(doc.DateIso)
        txtSubject.Text = doc.Subject
        MarkCustomer()
        Totals()
    End Sub

    Private Sub MarkCustomer()
        Dim i As Integer
        For i = 0 To customers.size() - 1
            If CType(customers.get(i), Customer).Id = doc.CustomerId Then
                cmbCustomer.setSelectedIndex(i)
                Exit Sub
            End If
        Next i
        cmbCustomer.setSelectedIndex(0)
    End Sub

    ' The lines into the table. The running number is in the first column, so that "line 3" means
    ' the same on screen as it does in a conversation.
    Private Sub ShowLines()
        tblLines.Clear()
        Dim i As Integer
        For i = 0 To doc.LineCount() - 1
            Dim p As DocumentLine = doc.LineAt(i)
            tblLines.AddRow(i + 1, p.Number, p.Name, _
                            Util.QuantityText(p.Quantity), p.Unit, _
                            Util.Money(p.UnitPrice), _
                            Util.QuantityText(p.VatRate) + " %", _
                            Util.Money(p.Amount()))
        Next i
        tblLines.Reload()
        Totals()
    End Sub

    Private Sub Totals()
        lblNet.Text = "Net: " + Util.MoneyWithEuro(doc.Net())
        lblTax.Text = "VAT: " + Util.MoneyWithEuro(doc.Tax())
        lblGross.Text = "Total: " + Util.MoneyWithEuro(doc.Gross())
    End Sub

    ' From the head of the screen into the document. Before every step that passes it on.
    Private Sub CollectHead()
        doc.DateIso = Util.DateToIso(txtDate.Text)
        doc.Subject = Trim(txtSubject.Text)

        Dim chosen As Object = cmbCustomer.getSelectedItem()
        If chosen Is Nothing Then
            doc.CustomerId = 0
            doc.CustomerName = ""
        Else
            Dim k As Customer = CType(chosen, Customer)
            doc.CustomerId = k.Id
            doc.CustomerName = k.Name
        End If
    End Sub

    ' --- the buttons ---------------------------------------------------------------------

    Private Sub OnCustomerChosen(e As ActionEvent)
        If building Then
            Exit Sub
        End If
        CollectHead()
    End Sub

    ' Adding a line changes an object and redraws one table. Nothing else on the screen is
    ' touched, and nothing at all reaches the database.
    Private Sub OnLineAdd(e As ActionEvent)
        Dim chosen As Object = cmbArticle.getSelectedItem()
        If chosen Is Nothing Then
            lblHint.Text = "Please choose an article first."
            Exit Sub
        End If

        Dim quantity As Double = Util.ToNumber(txtQuantity.Text)
        If quantity = 0 Then
            quantity = 1
        End If

        CollectHead()
        doc.AddLine(DocumentLine.FromArticle(CType(chosen, Article), quantity))
        txtQuantity.Text = "1"
        ShowLines()
        lblHint.Text = ""
    End Sub

    Private Sub OnLineRemove(e As ActionEvent)
        Dim row As Integer = tblLines.Table().getSelectedRow()
        If row < 0 OrElse row >= doc.LineCount() Then
            lblHint.Text = "Please select a line first."
            Exit Sub
        End If
        CollectHead()
        doc.RemoveLine(row)
        ShowLines()
        lblHint.Text = ""
    End Sub

    Private Sub OnSave(e As ActionEvent)
        CollectHead()

        If doc.CustomerId = 0 Then
            lblHint.Text = "The document cannot be saved without a customer."
            Exit Sub
        End If
        If doc.LineCount() = 0 Then
            lblHint.Text = "The document cannot be saved without lines."
            Exit Sub
        End If

        DocumentFile.Save(doc)
        shell.BackToDocuments()
        shell.Say(doc.Kind + " " + doc.Number + " saved - " _
                + Util.MoneyWithEuro(doc.Gross()) + ".")
    End Sub

    ' Make the next document out of this one without the detour through the list. It is saved
    ' first: an invoice whose quotation never existed would be hard to explain.
    Private Sub OnConvert(e As ActionEvent)
        CollectHead()
        If doc.CustomerId = 0 OrElse doc.LineCount() = 0 Then
            lblHint.Text = "Customer and lines first, then convert."
            Exit Sub
        End If

        DocumentFile.Save(doc)
        Dim fresh As Document = DocumentFile.CarryOver(doc, Document.INVOICE)

        shell.ShowDocumentSheet(fresh)
        shell.Say(doc.Kind + " " + doc.Number + " saved and carried over as invoice " _
                + fresh.Number + ". Not saved yet.")
    End Sub

    Private Sub OnBack(e As ActionEvent)
        shell.BackToDocuments()
    End Sub




