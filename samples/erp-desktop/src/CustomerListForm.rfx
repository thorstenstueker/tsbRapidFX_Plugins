' The customer list: search, select, edit, delete.
'
' The table shows text, but the work is done with customers. That is why the list hits sits
' beside it in the same order: the selected row number is then a customer rather than a row
' number, and nobody has to translate a cell back into a customer number.
'
' This screen is built once and kept by MainWindow. Coming back to it from a customer sheet does
' not build a new one - which is why the search box still holds what was typed into it.
Imports java.awt
Imports java.awt.event
Imports java.util
Imports javax.swing

Public Class CustomerListForm

    Private shell As MainWindow

    ' The customers currently in the table - row for row, the same order.
    Private hits As ArrayList = New ArrayList()

    Public Sub New(owner As MainWindow)
        InitDesignerComponents()
        shell = owner
        Fill()
    End Sub

    ' Called when the user comes back to this screen. The data may have changed underneath -
    ' somebody has just saved a customer - but what was typed and what was selected has not, and
    ' both are put back.
    Public Sub Refresh()
        Dim row As Integer = tblCustomers.Table().getSelectedRow()
        Fill()
        SelectRow(row)
    End Sub

    ' Searches and writes the result into the table.
    '
    ' Fill first, then one Reload: a thousand rows are one event that way instead of a thousand.
    Private Sub Fill()
        hits = CustomerFile.Search(txtSearch.Text)

        tblCustomers.Clear()
        Dim entry As Object
        For Each entry In hits
            Dim k As Customer = CType(entry, Customer)
            tblCustomers.AddRow(k.Number, k.Name, k.Contact, k.CityLine(), _
                                k.Phone, k.EMail)
        Next entry
        tblCustomers.Reload()

        lblCount.Text = hits.size() + " customers found"
        lblHint.Text = ""
    End Sub

    Private Sub SelectRow(row As Integer)
        If row >= 0 AndAlso row < hits.size() Then
            tblCustomers.Table().setRowSelectionInterval(row, row)
        End If
    End Sub

    ' The customer in the selected row, or Nothing.
    Private Function Chosen() As Customer
        Dim row As Integer = tblCustomers.Table().getSelectedRow()
        If row < 0 OrElse row >= hits.size() Then
            lblHint.Text = "Please select a row first."
            Return Nothing
        End If
        lblHint.Text = ""
        Return CType(hits.get(row), Customer)
    End Function

    ' --- the buttons ---------------------------------------------------------------------

    Private Sub OnSearch(e As ActionEvent)
        Fill()
    End Sub

    Private Sub OnAll(e As ActionEvent)
        txtSearch.Text = ""
        Fill()
    End Sub

    Private Sub OnNew(e As ActionEvent)
        shell.ShowCustomerSheet(0)
    End Sub

    Private Sub OnEdit(e As ActionEvent)
        Dim k As Customer = Chosen()
        If k Is Nothing Then
            Exit Sub
        End If
        shell.ShowCustomerSheet(k.Id)
    End Sub

    ' Deleting asks first. A customer who appears on a document stays - CustomerFile.Delete
    ' decides that and says so in one sentence, which we only pass on.
    '
    ' JOptionPane is the JDK's own dialog. It needs a parent window so that it appears over the
    ' right one and blocks it while it is open; MainWindow hands ours out.
    Private Sub OnDelete(e As ActionEvent)
        Dim k As Customer = Chosen()
        If k Is Nothing Then
            Exit Sub
        End If
        Dim answer As Integer = JOptionPane.showConfirmDialog(shell.Owner(), _
                "Really delete customer " + k.Number + " - " + k.Name + "?", _
                "Delete", JOptionPane.YES_NO_OPTION)
        If answer <> JOptionPane.YES_OPTION Then
            Exit Sub
        End If

        Dim problem As String = CustomerFile.Delete(k.Id)
        If problem <> "" Then
            lblHint.Text = problem
            Exit Sub
        End If
        Fill()
        lblHint.Text = "Customer " + k.Number + " deleted."
    End Sub




