' The article sheet: one article, every field, save or cancel.
'
' Price, tax rate and stock arrive as text and have to become numbers. Util.ToNumber does that,
' and leniently: "12,50" and "12.50" mean the same, and nonsense is 0 rather than an error
' dialog. A comma in a price field is not a mistake, it is German.
Imports java.awt
Imports java.awt.event
Imports javax.swing

Public Class ArticleSheetForm

    Private art As Article

    Public Sub New()
        InitDesignerComponents()
        art = Fetch()
        Display()
    End Sub

    Private Function Fetch() As Article
        If Main.ArticleId = 0 Then
            Dim fresh As Article = New Article()
            fresh.Number = ArticleFile.NextNumber()
            Return fresh
        End If
        Dim existing As Article = ArticleFile.Load(Main.ArticleId)
        If existing Is Nothing Then
            Return New Article()
        End If
        Return existing
    End Function

    Private Sub Display()
        If art.Id = 0 Then
            lblTitle.Text = "New article"
        Else
            lblTitle.Text = "Article " + art.Number
        End If
        txtNumber.Text = art.Number
        txtName.Text = art.Name
        txtUnit.Text = art.Unit
        txtPrice.Text = Util.Money(art.Price)
        txtVat.Text = Util.QuantityText(art.Vat)
        txtStock.Text = Util.QuantityText(art.Stock)
        txaDescription.Text = art.Description
    End Sub

    Private Sub Collect()
        art.Number = Trim(txtNumber.Text)
        art.Name = Trim(txtName.Text)
        art.Unit = Trim(txtUnit.Text)
        art.Price = Util.ToNumber(txtPrice.Text)
        art.Vat = Util.ToNumber(txtVat.Text)
        art.Stock = Util.ToNumber(txtStock.Text)
        art.Description = txaDescription.Text
    End Sub

    ' --- the buttons ---------------------------------------------------------------------

    Private Sub OnSave(e As ActionEvent)
        Collect()
        If art.Number = "" Then
            lblHint.Text = "An article number is required."
            Exit Sub
        End If
        If art.Name = "" Then
            lblHint.Text = "A name is required."
            Exit Sub
        End If

        ArticleFile.Save(art)
        Main.ArticleId = art.Id
        Main.ShowWith("articles", "Article " + art.Number + " saved.")
    End Sub

    Private Sub OnCancel(e As ActionEvent)
        Main.Show("articles")
    End Sub




