' The customer sheet: one customer, every field, save or cancel.
'
' Which customer is meant sits in Main.CustomerId - a SessionStatic. That is why this form needs
' no constructor parameter and the list needs to know nothing about how it is built. Zero means
' "a new customer", and then the number comes from the customer file.
Imports java.awt
Imports java.awt.event
Imports javax.swing

Public Class CustomerSheetForm

    ' The customer being edited. A field of this instance, not a Shared one - two users editing
    ' a customer at the same time have two forms and two customers.
    Private cust As Customer

    Public Sub New()
        InitDesignerComponents()
        cust = Fetch()
        Display()
    End Sub

    Private Function Fetch() As Customer
        If Main.CustomerId = 0 Then
            Dim fresh As Customer = New Customer()
            fresh.Number = CustomerFile.NextNumber()
            Return fresh
        End If
        Dim existing As Customer = CustomerFile.Load(Main.CustomerId)
        If existing Is Nothing Then
            Return New Customer()
        End If
        Return existing
    End Function

    ' From the customer into the fields.
    Private Sub Display()
        If cust.Id = 0 Then
            lblTitle.Text = "New customer"
        Else
            lblTitle.Text = "Customer " + cust.Number
        End If
        txtNumber.Text = cust.Number
        txtName.Text = cust.Name
        txtContact.Text = cust.Contact
        txtStreet.Text = cust.Street
        txtPostCode.Text = cust.PostCode
        txtCity.Text = cust.City
        txtCountry.Text = cust.Country
        txtEMail.Text = cust.EMail
        txtPhone.Text = cust.Phone
        txtVatId.Text = cust.VatId
        txaNote.Text = cust.Note
    End Sub

    ' From the fields into the customer.
    Private Sub Collect()
        cust.Number = Trim(txtNumber.Text)
        cust.Name = Trim(txtName.Text)
        cust.Contact = Trim(txtContact.Text)
        cust.Street = Trim(txtStreet.Text)
        cust.PostCode = Trim(txtPostCode.Text)
        cust.City = Trim(txtCity.Text)
        cust.Country = Trim(txtCountry.Text)
        cust.EMail = Trim(txtEMail.Text)
        cust.Phone = Trim(txtPhone.Text)
        cust.VatId = Trim(txtVatId.Text)
        cust.Note = txaNote.Text
    End Sub

    ' --- the buttons ---------------------------------------------------------------------

    Private Sub OnSave(e As ActionEvent)
        Collect()
        If cust.Number = "" Then
            lblHint.Text = "A customer number is required."
            Exit Sub
        End If
        If cust.Name = "" Then
            lblHint.Text = "A name is required."
            Exit Sub
        End If

        CustomerFile.Save(cust)
        Main.CustomerId = cust.Id
        Main.ShowWith("customers", "Customer " + cust.Number + " saved.")
    End Sub

    Private Sub OnCancel(e As ActionEvent)
        Main.Show("customers")
    End Sub




