' The sign-in screen - a form like any other, drawn in the designer.
'
' There is no HTML sign-in page and no sign-in endpoint anywhere in tsbWEB, and this is why: a
' sign-in box in the shell would be a second surface the designer cannot reach - for the one
' screen where a customer most wants their own layout. The password arrives in a field, the
' handler reads it, the session checks it.
'
' This half, above the banner, is yours. The designer writes it back unchanged and only ever
' adds to it - a missing import, an empty handler body.
Imports java.awt
Imports java.awt.event
Imports javax.swing
Imports com.tsbweb.session

Public Class SignInForm

    Public Sub New()
        InitDesignerComponents()
    End Sub

    ' On success there is nothing else to do: the server notices that the session changed, hands
    ' out a new id and rebuilds the display. That is why there is no rebuild here and no change
    ' of form.
    Private Sub OnSignIn(e As ActionEvent)
        If tsbWebSession.signIn(txtUser.Text, txtPassword.Password) Then
            Main.Screen = "customers"
            Main.Message = "Welcome to RapidX ERP."
        Else
            lblHint.Text = "Sign-in failed. Please try again."
        End If
    End Sub




