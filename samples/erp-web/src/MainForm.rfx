' The shell: a header, the navigation, and below it the area the actual screen sits in.
'
' The whole "router" of this application is here, and it is a Select Case statement. There are no
' addresses, no state machine and no navigation library: changing screen is a write into a
' SessionStatic and a request for a rebuild, and Content() then decides afresh.
Imports java.awt
Imports java.awt.event
Imports javax.swing
Imports com.tsbweb.session

Public Class MainForm

    Public Sub New()
        InitDesignerComponents()

        lblSignedIn.Text = "Signed in: " _
                + CType(tsbWebSession.User.get(), tsbWebUser).DisplayName
        lblMessage.Text = Main.TakeMessage()

        ' The content area gets a BorderLayout here instead of the anchors from the designer. It
        ' holds exactly one child - the screen currently chosen - and that child should fill it.
        ' In the designer it stays an empty panel with four anchors, so that one can see where it
        ' sits and how it grows.
        pnlContent.setLayout(New BorderLayout())
        pnlContent.add(Content(), BorderLayout.CENTER)

        MarkActive()
    End Sub

    ' Which screen stands in the content area.
    '
    ' A new instance every time. A form left lying between two rebuilds would be state outside
    ' the session - and that is exactly the kind that belongs to the next user on a server.
    Private Function Content() As Component
        Select Case Main.CurrentScreen()
            Case "customers"
                Return New CustomerListForm().GetRootPane()
            Case "customersheet"
                Return New CustomerSheetForm().GetRootPane()
            Case "articles"
                Return New ArticleListForm().GetRootPane()
            Case "articlesheet"
                Return New ArticleSheetForm().GetRootPane()
            Case "documents"
                Return New DocumentListForm().GetRootPane()
            Case "documentsheet"
                Return New DocumentSheetForm().GetRootPane()
        End Select
        Return New CustomerListForm().GetRootPane()
    End Function

    ' The button belonging to the visible screen goes bold. No border and no colour: both would
    ' have to match the theme, and the theme is the operator's to choose.
    Private Sub MarkActive()
        Dim screen As String = Main.CurrentScreen()
        Dim kind As String = Main.CurrentDocumentKind()
        Dim onDoc As Boolean = (screen = "documents") OrElse (screen = "documentsheet")

        Bold(btnCustomers, (screen = "customers") OrElse (screen = "customersheet"))
        Bold(btnArticles, (screen = "articles") OrElse (screen = "articlesheet"))
        Bold(btnQuotations, onDoc AndAlso (kind = Document.QUOTATION))
        Bold(btnDeliveryNotes, onDoc AndAlso (kind = Document.DELIVERYNOTE))
        Bold(btnInvoices, onDoc AndAlso (kind = Document.INVOICE))
    End Sub

    Private Sub Bold(button As JButton, active As Boolean)
        Dim style As Integer = Font.PLAIN
        If active Then
            style = Font.BOLD
        End If
        button.setFont(button.getFont().deriveFont(style))
    End Sub

    ' --- the navigation buttons ---------------------------------------------------------

    Private Sub OnCustomers(e As ActionEvent)
        Main.Show("customers")
    End Sub

    Private Sub OnArticles(e As ActionEvent)
        Main.Show("articles")
    End Sub

    Private Sub OnQuotations(e As ActionEvent)
        DocumentList(Document.QUOTATION)
    End Sub

    Private Sub OnDeliveryNotes(e As ActionEvent)
        DocumentList(Document.DELIVERYNOTE)
    End Sub

    Private Sub OnInvoices(e As ActionEvent)
        DocumentList(Document.INVOICE)
    End Sub

    Private Sub DocumentList(kind As String)
        Main.DocumentKind = kind
        Main.DocumentRow = -1
        Main.DocumentSearch = ""
        Main.Show("documents")
    End Sub

    ' Signs out and rebuilds - createRoot then decides on the sign-in screen again.
    Private Sub OnSignOut(e As ActionEvent)
        tsbWebSession.signOut()
    End Sub




