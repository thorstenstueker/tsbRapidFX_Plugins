' The document list - the same screen for quotations, delivery notes and invoices.
'
' Which kind is meant right now sits in Main.DocumentKind. Drawing three nearly identical forms
' would have been the obvious answer and the wrong one: a change to a column width would then be
' three changes, and the third one gets forgotten.
'
' What differs is two headings and whether the two carry-over buttons are visible. Both live in
' SetLabels().
Imports java.awt
Imports java.awt.event
Imports java.util
Imports javax.swing
Imports com.tsbweb.server
Imports com.tsbweb.session

Public Class DocumentListForm

    Private hits As ArrayList = New ArrayList()

    Public Sub New()
        InitDesignerComponents()
        SetLabels()
        txtSearch.Text = Util.Text(Main.DocumentSearch)
        Fill()
    End Sub

    ' What this screen currently is.
    Private Sub SetLabels()
        Dim kind As String = Main.CurrentDocumentKind()
        lblTitle.Text = Plural(kind)

        ' An invoice becomes nothing further; a delivery note becomes only an invoice.
        btnToDeliveryNote.setVisible((kind = Document.QUOTATION))
        btnToInvoice.setVisible((kind <> Document.INVOICE))
    End Sub

    Private Function Plural(kind As String) As String
        Select Case kind
            Case Document.QUOTATION
                Return "Quotations"
            Case Document.DELIVERYNOTE
                Return "Delivery notes"
            Case Document.INVOICE
                Return "Invoices"
        End Select
        Return "Documents"
    End Function

    Private Sub Fill()
        hits = DocumentFile.Search(Main.CurrentDocumentKind(), txtSearch.Text)

        tblDocuments.Clear()
        Dim entry As Object
        For Each entry In hits
            Dim d As Document = CType(entry, Document)
            tblDocuments.AddRow(d.Number, Util.DateShown(d.DateIso), d.CustomerName, _
                                d.Subject, d.LineCount(), Util.Money(d.Net()), _
                                Util.Money(d.Gross()), d.Status)
        Next entry
        tblDocuments.Reload()

        SelectRow(Main.DocumentRow)
        lblCount.Text = hits.size() + " " + Plural(Main.CurrentDocumentKind())
    End Sub

    Private Sub SelectRow(row As Integer)
        If row >= 0 AndAlso row < hits.size() Then
            tblDocuments.Table().setRowSelectionInterval(row, row)
        End If
    End Sub

    Private Function Chosen() As Document
        Dim row As Integer = tblDocuments.Table().getSelectedRow()
        If row < 0 OrElse row >= hits.size() Then
            lblHint.Text = "Please select a row first."
            Return Nothing
        End If
        Main.DocumentRow = row
        lblHint.Text = ""
        Return CType(hits.get(row), Document)
    End Function

    ' --- the buttons ---------------------------------------------------------------------

    Private Sub OnSearch(e As ActionEvent)
        Main.DocumentSearch = txtSearch.Text
        Main.DocumentRow = -1
        Fill()
    End Sub

    Private Sub OnAll(e As ActionEvent)
        txtSearch.Text = ""
        Main.DocumentSearch = ""
        Main.DocumentRow = -1
        Fill()
    End Sub

    ' A new document comes into being here and not in the database. It lies in the session as a
    ' draft until somebody saves it - which is why an accidental "New" costs nothing.
    Private Sub OnNew(e As ActionEvent)
        Dim kind As String = Main.CurrentDocumentKind()
        Dim fresh As Document = New Document()
        fresh.Kind = kind
        fresh.Number = DocumentFile.NextNumber(kind)

        Main.Draft = fresh
        Main.DocumentId = 0
        Main.DocumentSearch = txtSearch.Text
        Main.Show("documentsheet")
    End Sub

    Private Sub OnOpen(e As ActionEvent)
        Dim d As Document = Chosen()
        If d Is Nothing Then
            Exit Sub
        End If
        Main.Draft = DocumentFile.Load(d.Id)
        Main.DocumentId = d.Id
        Main.DocumentSearch = txtSearch.Text
        Main.Show("documentsheet")
    End Sub

    Private Sub OnDelete(e As ActionEvent)
        Dim d As Document = Chosen()
        If d Is Nothing Then
            Exit Sub
        End If
        Dim answer As Integer = tsbWebOptionPane.showConfirmDialog(GetRootPane(), _
                "Really delete " + d.Kind + " " + d.Number + "?", "Delete")
        If answer <> tsbWebOptionPane.YES_OPTION Then
            Exit Sub
        End If

        DocumentFile.Delete(d.Id)
        Main.DocumentRow = -1
        Fill()
        lblHint.Text = d.Kind + " " + d.Number + " deleted."
    End Sub

    Private Sub OnToDeliveryNote(e As ActionEvent)
        Convert(Document.DELIVERYNOTE)
    End Sub

    Private Sub OnToInvoice(e As ActionEvent)
        Convert(Document.INVOICE)
    End Sub

    ' CarryOver copies head and lines and issues a new number. The new document is then a draft
    ' like any other - it reaches the database only when somebody presses Save on the document
    ' sheet.
    Private Sub Convert(target As String)
        Dim source As Document = Chosen()
        If source Is Nothing Then
            Exit Sub
        End If

        Dim full As Document = DocumentFile.Load(source.Id)
        Dim fresh As Document = DocumentFile.CarryOver(full, target)

        Main.Draft = fresh
        Main.DocumentId = 0
        Main.DocumentKind = target
        Main.DocumentRow = -1
        Main.ShowWith("documentsheet", _
                source.Kind + " " + source.Number + " carried over as " + target + " " _
                + fresh.Number + ". Not saved yet.")
    End Sub




