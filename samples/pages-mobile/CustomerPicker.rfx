' The third screen: how an answer comes back.
'
' There is no ShowDialog that returns a value on a phone, because a phone has no modal dialogs in
' that sense. What there is instead: the caller hands in a handler, and this form calls it before
' it pops itself.
'
' The order matters and is the one thing worth reading twice. The handler runs BEFORE App.back, so
' it runs while this form is still in front and the calling form is still on the stack underneath —
' which is exactly why it may set a label there.

Imports tsb.mobile

Public Class CustomerPicker
    Implements Form

    Private wenn As ValueHandler

    Public Sub New(handler As ValueHandler)
        wenn = handler
    End Sub

    Private Sub OnFormBuilt()
        lblTitel.setText("Pick a customer")

        Dim i As Integer
        For i = 0 To CustomerList.Namen.Length - 1
            lstKunden.addItem(CustomerList.Namen(i))
        Next i
    End Sub

    Private Sub OnOkClick(source As Button)
        wenn.onValue(btnOk, lstKunden.getSelectedIndex())
        App.back()
    End Sub

    ' Cancelling is an answer too, and saying so explicitly is better than leaving the caller to
    ' wonder whether anything happened.
    Private Sub OnAbbruchClick(source As Button)
        wenn.onValue(btnAbbruch, -1)
        App.back()
    End Sub

'******************************************************************************
'                        the half a designer would write
'******************************************************************************

    ' @tsbmob form class=CustomerPicker geraet=PHONE w=390 h=844
    Private schirm As Screen = New Screen()

    ' @tsbmob Label lblTitel L=16 T=24 W=358 H=32
    Private lblTitel As Label = New Label()

    ' @tsbmob ListBox lstKunden L=16 T=8@lblTitel.BOTTOM W=358 H=240
    Private lstKunden As ListBox = New ListBox()

    ' @tsbmob Button btnOk L=16 T=16@lstKunden.BOTTOM W=358 H=48
    Private btnOk As Button = New Button()

    ' @tsbmob Button btnAbbruch L=16 T=8@btnOk.BOTTOM W=358 H=48
    Private btnAbbruch As Button = New Button()

    Public Function build() As Screen
        schirm.setTitle("Pick")

        lblTitel.setName("lblTitel")
        lblTitel.setSize(358, 32)
        schirm.add(lblTitel)

        lstKunden.setName("lstKunden")
        lstKunden.setSize(358, 240)
        schirm.add(lstKunden)

        btnOk.setName("btnOk")
        btnOk.setText("Take this one")
        btnOk.setSize(358, 48)
        btnOk.onClick(AddressOf OnOkClick)
        schirm.add(btnOk)

        btnAbbruch.setName("btnAbbruch")
        btnAbbruch.setText("Cancel")
        btnAbbruch.setSize(358, 48)
        btnAbbruch.onClick(AddressOf OnAbbruchClick)
        schirm.add(btnAbbruch)

        schirm.anchor(lblTitel, Edge.LEFT, 16)
        schirm.anchor(lblTitel, Edge.TOP, 24)
        schirm.anchor(lstKunden, Edge.LEFT, 16)
        schirm.anchor(lstKunden, Edge.TOP, 8, lblTitel, Edge.BOTTOM)
        schirm.anchor(btnOk, Edge.LEFT, 16)
        schirm.anchor(btnOk, Edge.TOP, 16, lstKunden, Edge.BOTTOM)
        schirm.anchor(btnAbbruch, Edge.LEFT, 16)
        schirm.anchor(btnAbbruch, Edge.TOP, 8, btnOk, Edge.BOTTOM)

        OnFormBuilt()

        Return schirm
    End Function
End Class
