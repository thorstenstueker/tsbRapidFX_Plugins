' The first screen: a list, and the two ways out of it.
'
' Written by hand rather than drawn, because what this sample is about is the navigation and not
' the designer. A real project draws its forms — see the user guide, chapter 2 — and the half below
' the banner looks much like the half below the line here.

Imports tsb.mobile

Public Class CustomerList
    Implements Form

    ' The data a real program would read from a database. Shared, so that the detail screen can
    ' reach it and the list keeps it while something else is in front.
    ' Three names. The bound goes in the declaration and counts inclusively, so (2) is three
    ' elements — there is no array literal to write them on one line.
    Public Shared Namen(2) As String

    Shared Sub New()
        Namen(0) = "Berger GmbH"
        Namen(1) = "Clausen AG"
        Namen(2) = "Dorn & Sohn"
    End Sub

    Private Sub OnFormBuilt()
        lblTitel.setText("Customers")
        lblHinweis.setText("Tap a row for the detail, or pick one below.")

        Dim i As Integer
        For i = 0 To Namen.Length - 1
            lstKunden.addItem(Namen(i))
        Next i
    End Sub

    ' A row was tapped: push the detail, with the number of the row it is about.
    '
    ' The detail is a new instance every time, so it is built fresh. Keeping one and showing it
    ' again would bring it back exactly as it was, which is right for a form somebody was typing
    ' into and wrong for one that shows a different customer each time.
    Private Sub OnKundenSelect(source As Widget, index As Integer, text As String)
        If index < 0 Then
            Return
        End If
        App.show(New CustomerDetail(index))
    End Sub

    ' The picker: pushed with a handler, and that handler is how the answer comes back.
    '
    ' There is no ShowDialog that returns a value on a phone. The picker calls this before it pops
    ' itself, so it runs while the picker is still in front and this form is still underneath —
    ' which is why setting a label here is allowed and does what you want.
    Private Sub OnWaehlenClick(source As Button)
        App.show(New CustomerPicker(AddressOf OnKundeGewaehlt))
    End Sub

    Private Sub OnKundeGewaehlt(source As Widget, index As Integer)
        If index < 0 Then
            lblGewaehlt.setText("Nothing picked")
        Else
            lblGewaehlt.setText("Picked: " + Namen(index))
        End If
    End Sub

'******************************************************************************
'                        the half a designer would write
'******************************************************************************

    ' @tsbmob form class=CustomerList geraet=PHONE w=390 h=844
    Private schirm As Screen = New Screen()

    ' @tsbmob Label lblTitel L=16 T=24 W=358 H=32
    Private lblTitel As Label = New Label()

    ' @tsbmob Label lblHinweis L=16 T=8@lblTitel.BOTTOM W=358 H=40
    Private lblHinweis As Label = New Label()

    ' @tsbmob ListBox lstKunden L=16 T=8@lblHinweis.BOTTOM W=358 H=200
    Private lstKunden As ListBox = New ListBox()

    ' @tsbmob Button btnWaehlen L=16 T=16@lstKunden.BOTTOM W=358 H=48
    Private btnWaehlen As Button = New Button()

    ' @tsbmob Label lblGewaehlt L=16 T=8@btnWaehlen.BOTTOM W=358 H=40
    Private lblGewaehlt As Label = New Label()

    Public Function build() As Screen
        schirm.setTitle("Customers")

        lblTitel.setName("lblTitel")
        lblTitel.setSize(358, 32)
        schirm.add(lblTitel)

        lblHinweis.setName("lblHinweis")
        lblHinweis.setSize(358, 40)
        schirm.add(lblHinweis)

        lstKunden.setName("lstKunden")
        lstKunden.setSize(358, 200)
        lstKunden.onSelect(AddressOf OnKundenSelect)
        schirm.add(lstKunden)

        btnWaehlen.setName("btnWaehlen")
        btnWaehlen.setText("Pick a customer")
        btnWaehlen.setSize(358, 48)
        btnWaehlen.onClick(AddressOf OnWaehlenClick)
        schirm.add(btnWaehlen)

        lblGewaehlt.setName("lblGewaehlt")
        lblGewaehlt.setSize(358, 40)
        schirm.add(lblGewaehlt)

        schirm.anchor(lblTitel, Edge.LEFT, 16)
        schirm.anchor(lblTitel, Edge.TOP, 24)
        schirm.anchor(lblHinweis, Edge.LEFT, 16)
        schirm.anchor(lblHinweis, Edge.TOP, 8, lblTitel, Edge.BOTTOM)
        schirm.anchor(lstKunden, Edge.LEFT, 16)
        schirm.anchor(lstKunden, Edge.TOP, 8, lblHinweis, Edge.BOTTOM)
        schirm.anchor(btnWaehlen, Edge.LEFT, 16)
        schirm.anchor(btnWaehlen, Edge.TOP, 16, lstKunden, Edge.BOTTOM)
        schirm.anchor(lblGewaehlt, Edge.LEFT, 16)
        schirm.anchor(lblGewaehlt, Edge.TOP, 8, btnWaehlen, Edge.BOTTOM)

        OnFormBuilt()

        Return schirm
    End Function
End Class
