' The article file - the same as CustomerFile, for articles.
'
' Deliberately the same shape: Search, Load, Save, Delete, NextNumber. Whoever has read one of
' the two knows the other.
Imports java.sql
Imports java.util

Module ArticleFile

    Public Function All() As ArrayList
        Return Search("")
    End Function

    ' Searches number, name and description.
    Public Function Search(text As String) As ArrayList
        Dim hits As ArrayList = New ArrayList()
        Dim pattern As String = "%" + LCase(Trim(Util.Text(text))) + "%"

        Using c As Connection = Database.Connect()
            Dim b As PreparedStatement = c.prepareStatement( _
                    "SELECT id, number, name, description, unit, price, vat, " _
                    + "stock FROM article " _
                    + "WHERE LOWER(number) LIKE ? OR LOWER(name) LIKE ? " _
                    + "   OR LOWER(IFNULL(description, '')) LIKE ? " _
                    + "ORDER BY number")
            Dim i As Integer
            For i = 1 To 3
                b.setString(i, pattern)
            Next i
            Dim r As ResultSet = b.executeQuery()
            Do While r.next()
                hits.add(ReadRow(r))
            Loop
            r.close()
            b.close()
        End Using
        Return hits
    End Function

    Public Function Load(id As Integer) As Article
        Dim found As Article = Nothing
        Using c As Connection = Database.Connect()
            Dim b As PreparedStatement = c.prepareStatement( _
                    "SELECT id, number, name, description, unit, price, vat, " _
                    + "stock FROM article WHERE id = ?")
            b.setInt(1, id)
            Dim r As ResultSet = b.executeQuery()
            If r.next() Then
                found = ReadRow(r)
            End If
            r.close()
            b.close()
        End Using
        Return found
    End Function

    Public Function Save(a As Article) As Integer
        Using c As Connection = Database.Connect()
            If a.Id = 0 Then
                Dim b As PreparedStatement = c.prepareStatement( _
                        "INSERT INTO article (number, name, description, unit, " _
                        + "price, vat, stock) VALUES (?, ?, ?, ?, ?, ?, ?)")
                BindRow(b, a)
                b.executeUpdate()
                b.close()
                ' Not getGeneratedKeys() — see Database.LastId, the reason stands there.
                a.Id = Database.LastId(c)
            Else
                Dim b As PreparedStatement = c.prepareStatement( _
                        "UPDATE article SET number = ?, name = ?, description = ?, " _
                        + "unit = ?, price = ?, vat = ?, stock = ? WHERE id = ?")
                BindRow(b, a)
                b.setInt(8, a.Id)
                b.executeUpdate()
                b.close()
            End If
        End Using
        Return a.Id
    End Function

    ' An article that appears on a document stays. The line does hold its own name and its own
    ' price - but the link back to the catalogue would be gone, and "which articles did we sell
    ' this year" could no longer be answered.
    Public Function Delete(id As Integer) As String
        Using c As Connection = Database.Connect()
            Dim p As PreparedStatement = c.prepareStatement( _
                    "SELECT COUNT(*) FROM documentline WHERE article_id = ?")
            p.setInt(1, id)
            Dim r As ResultSet = p.executeQuery()
            Dim used As Integer = 0
            If r.next() Then
                used = r.getInt(1)
            End If
            r.close()
            p.close()

            If used > 0 Then
                Return "The article appears on " + used + " document lines and stays."
            End If

            Dim b As PreparedStatement = c.prepareStatement("DELETE FROM article WHERE id = ?")
            b.setInt(1, id)
            b.executeUpdate()
            b.close()
        End Using
        Return ""
    End Function

    Public Function NextNumber() As String
        Dim highest As Integer = 1000
        Using c As Connection = Database.Connect()
            Dim s As Statement = c.createStatement()
            Dim r As ResultSet = s.executeQuery("SELECT number FROM article")
            Do While r.next()
                Dim number As String = Util.Text(r.getString(1))
                Dim digits As Integer = CInt(Val(Replace(number, "A-", "")))
                If digits > highest Then
                    highest = digits
                End If
            Loop
            r.close()
            s.close()
        End Using
        Return "A-" + (highest + 1)
    End Function

    ' --- inside -----------------------------------------------------------------------

    Private Function ReadRow(r As ResultSet) As Article
        Dim a As Article = New Article()
        a.Id = r.getInt(1)
        a.Number = Util.Text(r.getString(2))
        a.Name = Util.Text(r.getString(3))
        a.Description = Util.Text(r.getString(4))
        a.Unit = Util.Text(r.getString(5))
        a.Price = r.getDouble(6)
        a.Vat = r.getDouble(7)
        a.Stock = r.getDouble(8)
        Return a
    End Function

    Private Sub BindRow(b As PreparedStatement, a As Article)
        b.setString(1, a.Number)
        b.setString(2, a.Name)
        b.setString(3, a.Description)
        b.setString(4, a.Unit)
        b.setDouble(5, a.Price)
        b.setDouble(6, a.Vat)
        b.setDouble(7, a.Stock)
    End Sub

End Module
