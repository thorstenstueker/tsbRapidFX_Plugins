' One article of the catalogue.
'
' Price is always the net price per unit, Vat the rate as a percentage - 19, not 0.19. Both are
' copied onto a document line when one is created, so that a later change of price cannot make
' an old quotation retrospectively more expensive.

Public Class Article

    Public Property Id As Integer
    Public Property Number As String
    Public Property Name As String
    Public Property Description As String
    Public Property Unit As String
    Public Property Price As Double
    Public Property Vat As Double
    Public Property Stock As Double

    Public Sub New()
        Id = 0
        Number = ""
        Name = ""
        Description = ""
        Unit = "Piece"
        Price = 0
        Vat = 19
        Stock = 0
    End Sub

    ' What a combo box shows: "A-1001  Kabelbinder 200 mm".
    Public Overrides Function toString() As String
        Return Number + "  " + Name
    End Function

End Class
