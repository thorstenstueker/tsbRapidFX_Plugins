' One article, to look at and to change.
'
' A full screen, not a dialog — the same decision the desktop makes, and on a tablet there is
' not even a choice: a modal window over a form is a desktop idea.
'
' The logic below is the desktop's ArticleSheetForm almost line for line: Fetch, Display,
' Collect, validate, save, go back. What changed is the widgets and that the shell is a Module
' rather than a MainWindow instance.

Imports tsb.mobile

Public Class ArticleSheetForm
    Implements Form

    ' The record being edited. Id = 0 means it does not exist yet.
    Private art As Article

    ' Which article to show. 0 is "a new one" — the same convention as the desktop, where
    ' ShowArticleSheet(0) is what the New button calls.
    Private wanted As Integer = 0

    Public Sub New(id As Integer)
        wanted = id
    End Sub

    Private Sub OnFormBuilt()
        drpArea.setItems(Shell.Areas())
        drpArea.setSelectedIndex(1)

        art = Fetch(wanted)
        Display()
    End Sub

    Private Function Fetch(id As Integer) As Article
        If id = 0 Then
            Dim fresh As Article = New Article()
            fresh.Number = ArticleFile.NextNumber()
            Return fresh
        End If
        Dim existing As Article = ArticleFile.Load(id)
        If existing Is Nothing Then
            Return New Article()
        End If
        Return existing
    End Function

    Private Sub Display()
        If art.Id = 0 Then
            lblTitle.setText("New article")
        Else
            lblTitle.setText("Article " + art.Number)
        End If
        txtNumber.setText(art.Number)
        txtName.setText(Util.Text(art.Name))
        txtUnit.setText(Util.Text(art.Unit))
        txtPrice.setText(Util.Money(art.Price))
        txtVat.setText(Util.QuantityText(art.Vat))
        txtStock.setText(Util.QuantityText(art.Stock))
        txaDescription.setText(Util.Text(art.Description))
        lblHint.setText("")
    End Sub

    Private Sub Collect()
        art.Number = Trim(txtNumber.getText())
        art.Name = Trim(txtName.getText())
        art.Unit = Trim(txtUnit.getText())
        art.Price = Util.ToNumber(txtPrice.getText())
        art.Vat = Util.ToNumber(txtVat.getText())
        art.Stock = Util.ToNumber(txtStock.getText())
        art.Description = txaDescription.getText()
    End Sub

    ' --- what the buttons do ---------------------------------------------------------

    Private Sub OnSave(source As Button)
        Collect()
        If art.Number = "" Then
            lblHint.setText("An article number is required.")
            Exit Sub
        End If
        If art.Name = "" Then
            lblHint.setText("A name is required.")
            Exit Sub
        End If

        ArticleFile.Save(art)
        Shell.ShowArticles()
        Shell.Say("Article " + art.Number + " saved.")
    End Sub

    Private Sub OnCancel(source As Button)
        Shell.ShowArticles()
    End Sub

    ' Deleting is refused when the article is on a document — the rule lives in ArticleFile and
    ' comes back as a sentence, not as a boolean. Showing it is all this has to do.
    Private Sub OnDelete(source As Button)
        If art.Id = 0 Then
            Shell.ShowArticles()
            Exit Sub
        End If
        Dim refused As String = ArticleFile.Delete(art.Id)
        If refused <> "" Then
            lblHint.setText(refused)
            Exit Sub
        End If
        Shell.ShowArticles()
        Shell.Say("Article " + art.Number + " deleted.")
    End Sub

    ' --- the navigation ----------------------------------------------------------------

    ' Switches area — and ignores its own number.
    '
    ' NOT through a building flag, although the desktop does it that way. Android's Spinner
    ' calls its listener **afterwards**, after the layout — by then the flag is long back to
    ' False, and the form navigates away from itself. Measured: display() was called twice,
    ' the second time after the click handler.
    '
    ' Comparing against its own index is immune to any ordering, and it also says something
    ' true: choosing the area you are already in does nothing.
    Private Sub OnAreaChosen(source As Widget, index As Integer, text As String)
        If index = 1 Then
            Exit Sub
        End If
        Shell.GoTo(index)
    End Sub




'******************************************************************************
'******************************************************************************
'******************************************************************************
'
