' One customer, to look at and to change.
'
' Deliberately the same shape as ArticleSheetForm — Fetch, Display, Collect, validate, save,
' back. Twelve fields instead of eight, so they sit in three columns rather than four; that is
' the whole difference.

Imports tsb.mobile

Public Class CustomerSheetForm
    Implements Form

    Private cust As Customer
    Private wanted As Integer = 0

    Public Sub New(id As Integer)
        wanted = id
    End Sub

    Private Sub OnFormBuilt()
        drpArea.setItems(Shell.Areas())
        drpArea.setSelectedIndex(0)

        cust = Fetch(wanted)
        Display()
    End Sub

    Private Function Fetch(id As Integer) As Customer
        If id = 0 Then
            Dim fresh As Customer = New Customer()
            fresh.Number = CustomerFile.NextNumber()
            Return fresh
        End If
        Dim existing As Customer = CustomerFile.Load(id)
        If existing Is Nothing Then
            Return New Customer()
        End If
        Return existing
    End Function

    Private Sub Display()
        If cust.Id = 0 Then
            lblTitle.setText("New customer")
        Else
            lblTitle.setText("Customer " + cust.Number)
        End If
        txtNumber.setText(cust.Number)
        txtName.setText(Util.Text(cust.Name))
        txtContact.setText(Util.Text(cust.Contact))
        txtStreet.setText(Util.Text(cust.Street))
        txtPostCode.setText(Util.Text(cust.PostCode))
        txtCity.setText(Util.Text(cust.City))
        txtCountry.setText(Util.Text(cust.Country))
        txtEMail.setText(Util.Text(cust.EMail))
        txtPhone.setText(Util.Text(cust.Phone))
        txtVatId.setText(Util.Text(cust.VatId))
        txaNote.setText(Util.Text(cust.Note))
        lblHint.setText("")
    End Sub

    Private Sub Collect()
        cust.Number = Trim(txtNumber.getText())
        cust.Name = Trim(txtName.getText())
        cust.Contact = Trim(txtContact.getText())
        cust.Street = Trim(txtStreet.getText())
        cust.PostCode = Trim(txtPostCode.getText())
        cust.City = Trim(txtCity.getText())
        cust.Country = Trim(txtCountry.getText())
        cust.EMail = Trim(txtEMail.getText())
        cust.Phone = Trim(txtPhone.getText())
        cust.VatId = Trim(txtVatId.getText())
        cust.Note = txaNote.getText()
    End Sub

    ' --- what the buttons do ---------------------------------------------------------

    Private Sub OnSave(source As Button)
        Collect()
        If cust.Number = "" Then
            lblHint.setText("A customer number is required.")
            Exit Sub
        End If
        If cust.Name = "" Then
            lblHint.setText("A name is required.")
            Exit Sub
        End If

        CustomerFile.Save(cust)
        Shell.ShowCustomers()
        Shell.Say("Customer " + cust.Number + " saved.")
    End Sub

    Private Sub OnCancel(source As Button)
        Shell.ShowCustomers()
    End Sub

    ' A customer who appears on a document is not deleted. CustomerFile says so in a sentence.
    Private Sub OnDelete(source As Button)
        If cust.Id = 0 Then
            Shell.ShowCustomers()
            Exit Sub
        End If
        Dim refused As String = CustomerFile.Delete(cust.Id)
        If refused <> "" Then
            lblHint.setText(refused)
            Exit Sub
        End If
        Shell.ShowCustomers()
        Shell.Say("Customer " + cust.Number + " deleted.")
    End Sub

    ' --- the navigation ----------------------------------------------------------------

    ' Ignores its own number — see ArticleListForm.OnAreaChosen for why this is not a flag.
    Private Sub OnAreaChosen(source As Widget, index As Integer, text As String)
        If index = 0 Then
            Exit Sub
        End If
        Shell.GoTo(index)
    End Sub




'******************************************************************************
'******************************************************************************
'******************************************************************************
'
'                                 DO NOT EDIT
'                             TSB RAPIDFX MOBILE
'
'******************************************************************************
