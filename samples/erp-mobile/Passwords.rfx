' Hashing a password, and checking one.
'
' The web version of this program borrowed this from the tsbWEB session library. A desktop
' program has no such library, and writing it out is no loss - it is thirty lines, and they are
' worth reading once, because almost every program eventually needs them.
'
' A password is never stored. What is stored is the result of running it through PBKDF2, which is
' a deliberately slow one-way function: from the password you can compute the hash, and from the
' hash you cannot get back to the password. Checking a password means hashing what was typed and
' comparing the two results.
'
' Three things make the difference between this and a naive hash:
'
'   the salt        sixteen random bytes, different for every user, stored beside the hash. Two
'                   people with the same password therefore have different hashes, and a table
'                   of pre-computed hashes is of no use to an attacker.
'   the iterations  the function is run 120000 times over. That is unnoticeable once, at
'                   sign-in, and ruinous for somebody trying millions of guesses.
'   the comparison  MessageDigest.isEqual always looks at every byte. A plain "=" would stop at
'                   the first difference, and how long it took would leak how much was right.
Imports java.security
Imports javax.crypto
Imports javax.crypto.spec

Module Passwords

    Private Const ITERATIONS As Integer = 120000
    Private Const BITS As Integer = 256
    Private Const SALT_BYTES As Integer = 16

    ' Makes the text that goes into the database. It carries everything needed to check a
    ' password later, and nothing that would help anybody guess one:
    '
    '     pbkdf2$120000$<salt, base64>$<hash, base64>
    '
    ' The iteration count travels with the hash on purpose. Raising it next year must not
    ' invalidate the passwords stored this year - old rows keep their old number.
    Public Function Hash(password As String) As String
        Dim salt(SALT_BYTES - 1) As Byte
        New SecureRandom().nextBytes(salt)
        Return "pbkdf2$" + ITERATIONS + "$" + Encode(salt) + "$" _
                + Encode(Derive(password, salt, ITERATIONS))
    End Function

    ' True when the password fits what was stored. Anything unreadable is False, never an error:
    ' a broken row in the users table must mean "you cannot sign in", not a crash on the
    ' sign-in screen.
    Public Function Matches(password As String, stored As String) As Boolean
        If stored Is Nothing Then
            Return False
        End If
        Dim parts As String() = Split(stored, "$")
        If UBound(parts) <> 3 Then
            Return False
        End If
        If parts(0) <> "pbkdf2" Then
            Return False
        End If

        Try
            Dim rounds As Integer = CInt(Val(parts(1)))
            Dim salt As Byte() = Decode(parts(2))
            Dim want As Byte() = Decode(parts(3))
            Return MessageDigest.isEqual(Derive(password, salt, rounds), want)
        Catch e As java.lang.Exception
            Return False
        End Try
    End Function

    ' --- inside -----------------------------------------------------------------------

    Private Function Derive(password As String, salt As Byte(), rounds As Integer) As Byte()
        Dim spec As PBEKeySpec = New PBEKeySpec(password.toCharArray(), salt, rounds, BITS)
        Dim factory As SecretKeyFactory = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256")
        Return factory.generateSecret(spec).getEncoded()
    End Function

    ' Base64 turns arbitrary bytes into letters and digits, so that a hash can live in a TEXT
    ' column and be read out again byte for byte.
    Private Function Encode(raw As Byte()) As String
        Return java.util.Base64.getEncoder().encodeToString(raw)
    End Function

    Private Function Decode(text As String) As Byte()
        Return java.util.Base64.getDecoder().decode(text)
    End Function

End Module
