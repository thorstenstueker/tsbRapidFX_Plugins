' Two pages in a browser.
'
' There is no navigation and no router. createRoot is asked which page to draw, and
' it is asked again on every rebuild — so changing page is writing into the session
' and asking for one.
Imports java.awt
Imports com.tsbweb.server
Imports com.tsbweb.session

Module Main
    Sub Main()
        Dim config As tsbWebConfig = New tsbWebConfig()
        config.Port = 8099
        config.Title = "Two pages"
        tsbWebStart.Go(config, New Application())
    End Sub
End Module

Public Class Application
    Implements tsbWebApp

    Public Function title() As String
        Return "Two pages"
    End Function

    ' A new instance per session, never a shared one: two visitors sharing one form
    ' would watch each other click.
    Public Function createRoot(session As tsbWebSession) As Component
        If "two".equals(session.getValue("page")) Then
            Return New PageTwo().GetRootPane()
        End If
        Return New PageOne().GetRootPane()
    End Function
End Class
