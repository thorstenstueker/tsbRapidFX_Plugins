' The list. Changing to the detail is two lines and no navigation call.

Imports javax.swing
Imports java.awt
Imports com.tsbweb.session

Public Class CustomerList

    Public Shared Namen(2) As String

    Shared Sub New()
        Namen(0) = "Berger GmbH"
        Namen(1) = "Clausen AG"
        Namen(2) = "Dorn & Sohn"
    End Sub

    Private wurzel As JPanel = New JPanel()
    Private liste As JList = New JList()

    ' Both halves are needed. Writing into the session alone changes nothing on the screen —
    ' createRoot is only asked again when something asks for a rebuild.
    '
    ' And this is where you pass something to the next screen: there is no parameter, because
    ' there is no call. Put it in the session and read it there.
    Private Sub OnOeffnen()
        If liste.getSelectedIndex() < 0 Then
            Return
        End If
        tsbWebSession.setValue("customer", liste.getSelectedIndex())
        tsbWebSession.setValue("screen", "detail")
        tsbWebSession.rebuild()
    End Sub

    Private Sub OnAbmelden()
        tsbWebSession.signOut()
        tsbWebSession.rebuild()
    End Sub

    Public Function GetRootPane() As JPanel
        wurzel.setLayout(New BorderLayout(8, 8))
        wurzel.setBorder(BorderFactory.createEmptyBorder(12, 12, 12, 12))

        liste.setListData(Namen)
        liste.setSelectedIndex(0)
        wurzel.add(New JScrollPane(liste), BorderLayout.CENTER)

        Dim knoepfe As JPanel = New JPanel(New GridLayout(1, 2, 6, 0))
        Dim btnOeffnen As JButton = New JButton("Open the detail")
        Dim btnAbmelden As JButton = New JButton("Sign out")
        btnOeffnen.addActionListener(Sub(e) OnOeffnen())
        btnAbmelden.addActionListener(Sub(e) OnAbmelden())
        knoepfe.add(btnOeffnen)
        knoepfe.add(btnAbmelden)
        wurzel.add(knoepfe, BorderLayout.SOUTH)

        Return wurzel
    End Function

End Class
