\clbrdrt\brdrs\brdrw8\brdrcf4\clbrdrl\brdrs\brdrw8\brdrcf4\clbrdrb\brdrs\brdrw8\brdrcf4\clbrdrr\brdrs\brdrw8\brdrcf4\cellx9580
\pard\plain\intbl\sb20\sa20\f0\fs19\cf1\b0 {\f1\fs18 Enum}\cell
\pard\plain\intbl\sb20\sa20\f0\fs19\cf1\b0 a fixed set of named values\cell
\row
\trowd\trgaph80\trleft0\trpaddl80\trpaddr80\trpaddt40\trpaddb40
\clbrdrt\brdrs\brdrw8\brdrcf4\clbrdrl\brdrs\brdrw8\brdrcf4\clbrdrb\brdrs\brdrw8\brdrcf4\clbrdrr\brdrs\brdrw8\brdrcf4\cellx4790
\clbrdrt\brdrs\brdrw8\brdrcf4\clbrdrl\brdrs\brdrw8\brdrcf4\clbrdrb\brdrs\brdrw8\brdrcf4\clbrdrr\brdrs\brdrw8\brdrcf4\cellx9580
\pard\plain\intbl\sb20\sa20\f0\fs19\cf1\b0 {\f1\fs18 Structure}\cell
\pard\plain\intbl\sb20\sa20\f0\fs19\cf1\b0 a {\i value}, not a reference\cell
\row
\pard\sb0\sa140

\pard\plain\keepn\sb280\sa100\f2\b\fs26\cf1 Module\par
\pard\plain\sb0\sa140\sl276\slmult1\f0\fs21\cf1\qj A container for procedures and shared data. Everything in it is automatically shared, and nothing can be instantiated from it.\par
\pard\plain\li260\ri200\sb120\sa160\sl240\slmult1\box\brdrs\brdrw10\brdrcf4\brsp40\cbpat3\f1\fs17\cf1 Module Calculator\line 
    Public Shared Calls As Integer = 0\line 
\line 
    Function Double(x As Integer) As Integer\line 
        Calls += 1\line 
        Return x * 2\line 
    End Function\line 
End Module\par
\pard\sb0\sa0\cbpat0\par
\pard\plain\sb0\sa140\sl276\slmult1\f0\fs21\cf1\qj From Java this is a final class with static methods \u8212? {\f1\fs18 Calculator.Double(21)} works there unchanged.\par
\pard\plain\keepn\sb280\sa100\f2\b\fs26\cf1 Class\par
\pard\plain\li260\ri200\sb120\sa160\sl240\slmult1\box\brdrs\brdrw10\brdrcf4\brsp40\cbpat3\f1\fs17\cf1 Public Class Account\line 
    Private owner As String\line 
    Private balance As Double\line 
\line 
    Public Sub New(name As String)\line 
        owner = name\line 
        balance = 0\line 
    End Sub\line 
\line 
    Public Sub Deposit(amount As Double)\line 
        If amount <= 0 Then Throw New java.lang.IllegalArgumentException("amount <= 0")\line 
        balance += amount\line 
    End Sub\line 
\line 
    Public Function Balance() As Double\line 
        Return balance\line 
    End Function\line 
End Class\par
\pard\sb0\sa0\cbpat0\par
\pard\plain\sb0\sa140\sl276\slmult1\f0\fs21\cf1\qj A field is found without {\f1\fs18 Me.}; you write {\f1\fs18 Me} when a parameter hides the name. {\b Constructors are called {\f1\fs18\b Sub New}.} Without one, the class gets a parameterless constructor. A field with an initial value is set in {\i every} constructor before its body runs.\par
\pard\plain\sb0\sa140\sl276\slmult1\f0\fs21\cf1\qj {\b {\f1\fs18\b Shared}} \u8212? or {\f1\fs18 Static}, the same word differently spelled \u8212? makes a member belong to the type rather than the instance. In a {\f1\fs18 Module} neither is needed: everything there is shared anyway.\par
\pard\plain\li360\ri200\sb140\sa180\sl276\slmult1\brdrl\brdrs\brdrw40\brdrcf5\brsp120\f0\fs20\cf1 VB6's {\f1\fs18 Static} \u8212? a {\i local} variable that keeps its value between calls \u8212? is a different thing and is not built. It would stand in a body rather than in front of a declaration, so the two cannot collide.\par
\pard\sb0\sa0\par
\pard\plain\keepn\sb280\sa100\f2\b\fs26\cf1 Inheritance\par
\pard\plain\li260\ri200\sb120\sa160\sl240\slmult1\box\brdrs\brdrw10\brdrcf4\brsp40\cbpat3\f1\fs17\cf1 Public MustInherit Class Animal\line 
    Public Property Name As String\line 
\line 
    Public Sub New(name As String)\line 
        Me.Name = name\line 
    End Sub\line 
\line 
    Public Overridable Function Describe() As String\line 
        Return "An animal called " + Name\line 
    End Function\line 
\line 
    Public MustOverride Function Sound() As String\line 
End Class\line 
\line 
Public Class Dog\line 
    Inherits Animal\line 
\line 
    Public Sub New(name As String)\line 
        MyBase.New(name)\line 
    End Sub\line 
\line 
    Public Overrides Function Describe() As String\line 
        Return "Dog: " + MyBase.Describe()\line 
    End Function\line 
\line 
    Public Function Sound() As String\line 
        Return "Woof"\line 
    End Function\line 
End Class\par
\pard\sb0\sa0\cbpat0\par
