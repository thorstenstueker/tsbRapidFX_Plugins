\clbrdrt\brdrs\brdrw8\brdrcf4\clbrdrl\brdrs\brdrw8\brdrcf4\clbrdrb\brdrs\brdrw8\brdrcf4\clbrdrr\brdrs\brdrw8\brdrcf4\cellx9580
